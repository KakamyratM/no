<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Geography Explorer</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- External CSS File -->
    <link rel="stylesheet" href="styles.css">
</head>
<body>

<header>
    <h1>Geography Explorer</h1>
</header>

<main>
    <section class="card">
        <h2>About the Earth</h2>
        <p>
            Earth is the third planet from the Sun and the only known planet to support life.
            It has diverse landscapes including mountains, rivers, deserts, and oceans.
        </p>

        <h3>Major Continents</h3>
        <ul>
            <li>Africa</li>
            <li>Asia</li>
            <li>Europe</li>
            <li>North America</li>
            <li>South America</li>
            <li>Australia</li>
            <li>Antarctica</li>
        </ul>

        <button id="actionBtn">Show Fun Fact</button>
        <p id="message"></p>
    </section>
</main>

<footer>
    <p>&copy; 2026 Geography Explorer</p>
</footer>

<script>
    document.getElementById("actionBtn").addEventListener("click", function() {
        document.getElementById("message").textContent =
            "Fun Fact: The Pacific Ocean is the largest ocean on Earth!";
    });
</script>

</body>
</html>
